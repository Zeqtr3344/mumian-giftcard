# Public address of this app (no trailing slash)
APP_URL=https://giftcard.mumian.au

# Supabase → Project settings → API
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Stripe → Developers → API keys (use sk_test_ first, then sk_live_)
STRIPE_SECRET_KEY=
# Stripe → Developers → Webhooks → endpoint https://giftcard.mumian.au/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=

# Resend → API keys. FROM must be on a domain verified in Resend (mumian.au)
RESEND_API_KEY=
FROM_EMAIL=MuMian Dining <hi@mumian.au>
REPLY_TO_EMAIL=hi@mumian.au

# Long random strings: run  openssl rand -base64 32  for each
SESSION_SECRET=
CRON_SECRET=

# Optional settings
GIFT_CARD_EXPIRY_MONTHS=36
MIN_AMOUNT_DOLLARS=20
MAX_AMOUNT_DOLLARS=1000
